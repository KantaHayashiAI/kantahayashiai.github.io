{
  "name": "kanta-hayashi-blog",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run og && astro dev",
    "check": "astro check",
    "build": "npm run validate && npm run og && astro check && astro build && pagefind --site dist && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "new": "node scripts/new-post.mjs",
    "og": "node scripts/build-og.mjs",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "astro": "7.0.3",
    "@astrojs/mdx": "7.0.0",
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/rss": "4.0.19",
    "@shikijs/transformers": "4.4.3",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "gray-matter": "4.0.3",
    "katex": "0.16.27",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "satori": "0.26.0",
    "sharp": "0.35.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "pagefind": "1.5.2",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
