---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import site from "../config/site.mjs";
import {visiblePosts} from "../lib/content.mjs";
import {about,searchPage,lab} from "../lib/ui.mjs";
export function getStaticPaths() { return ["about","search",...(site.stage==="preview"?["lab"]:[])].map(page=>({params:{page}})); }
const {page}=Astro.params;
const posts=visiblePosts(await getCollection("posts"));
const content=page==="about"?about("en"):page==="search"?searchPage("en"):lab(posts,"en");
const title=page==="about"?"About":page==="search"?"Search":"Preview checklist";
---
<Layout title={title} lang="en"><Fragment set:html={content} /></Layout>
