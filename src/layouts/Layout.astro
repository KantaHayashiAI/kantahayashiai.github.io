---
// Adapted from AstroPaper's metadata/theme layout. No client-side router is required.
import site from "../config/site.mjs";
import { headMeta, header, footer, themeInit } from "../lib/ui.mjs";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/noto-sans-jp/400.css";
import "@fontsource/noto-sans-jp/700.css";
import "katex/dist/katex.min.css";
interface Props { title?: string; description?: string; lang?: "en" | "ja"; sample?: boolean; post?: any; other?: any; }
const { title = site.title, description, lang = "en", sample = false, post = null, other = null } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={lang}>
  <head>
    <Fragment set:html={headMeta({title,description,path,lang,sample,post,other})} />
    <Fragment set:html={'<meta name="google-site-verification" content="MpN9J4CSU90P-dRN9pDSocVxcI4Hm4_he7_bI6O1Hvs" />'} />
    <script is:inline set:html={themeInit} />
    <link rel="stylesheet" href="/site.css" />
    <slot name="head" />
  </head>
  <body>
    <Fragment set:html={header(path,lang)} />
    <slot />
    <Fragment set:html={footer(lang)} />
    <dialog id="image-viewer" aria-label={lang==='ja'?'画像の拡大表示':'Expanded image'}>
      <button type="button" class="close-viewer">{lang==='ja'?'閉じる':'Close'} ×</button>
      <img alt="" />
    </dialog>
    <script is:inline src="/site.js" defer />
    {import.meta.env.PROD && <Fragment set:html={'<script data-goatcounter="https://kantahayashi.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>'} />}
  </body>
</html>
